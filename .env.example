# Food Truck Kiosk — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# ---- Server ----
PORT=4242
HOST=0.0.0.0
NODE_ENV=development

# ---- Security ----
# SHA-256 hash of the admin PIN (generate: node server/scripts/pin-hash.js <pin>)
ADMIN_PIN_SHA256=81dfcf8b0cb5b1a4f4c0b1c1b1d3b78c9e2f6c9a6e0f0a1b2c3d4e5f6a7b8c9d
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database / uploads ----
DB_PATH=data/kiosk.db
UPLOAD_DIR=data/uploads

# ---- Payments ----
# NOT INTEGRATED YET — the kiosk PAY NOW screen is a blank placeholder.
# Integrate PhonePe later; full plan: docs/PHONEPE_INTEGRATION.md
PAYMENT_MODE=test
PAYMENT_PROVIDER=none
# PhonePe credentials (fill in at integration time; secret stays server-side only)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# ---- Printing ----
# simulated | escpos-network | escpos-usb | escpos-serial | bluetooth
PRINTER_DRIVER=simulated
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_DEVICE=
BT_PRINTER_URL=

# ---- UPI QR (used by receipts/preview only) ----
CURRENCY=INR
VPA=foodtruck@upi
